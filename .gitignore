.venv/
__pycache__/
projects/*/out/
projects/*/stems/
projects/*/data/whisper_words.json
projects/*/data/audio_qa.png
.DS_Store

# Songs and their lyrics belong to their authors. Keep them on your own machine only: copy the song into
# projects/<name>/audio/ and write projects/<name>/lyrics.txt locally. Every file that carries the lyric text is
# ignored, in every project (the aligned lyrics, the timing fixes, the low-confidence report, Whisper's words):
projects/*/audio/
projects/*/lyrics.txt
projects/*/data/lyrics*
# …except lyrics that can be shared: the P(doom) example (anime-pdoom; roto-demo reads its data) and the
# placeholder lines written for lumen-demo, solid-demo and field-demo.
!projects/anime-pdoom/data/lyrics.js
!projects/anime-pdoom/data/lyrics.json
!projects/lumen-demo/data/lyrics.js
!projects/solid-demo/data/lyrics.js
!projects/field-demo/data/lyrics.js
# pdoom-akari: the generated video clips (art/clips/, ~420 MB) and the frame packs made from them and from the stills
# (frames/, ~560 MB) are too big for this repository: they stay on the machine that made them.
projects/pdoom-akari/art/clips/
projects/pdoom-akari/frames/
# the 即梦 CLI's account dump (it carries the user id): never commit it, in any project
projects/*/art/dreamina/account.json

# codebase-memory-mcp 生成的索引产物（本机生成，不入库；注意与需要入库的 .cbmignore 区分）
.codebase-memory/
