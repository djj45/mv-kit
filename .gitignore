.venv/
__pycache__/
projects/*/out/
projects/*/stems/
projects/*/data/whisper_words.json
projects/*/data/audio_qa.png
.DS_Store

# Songs and their lyrics belong to their authors. Keep them on your own machine only: copy the song into
# projects/<name>/audio/ and write projects/<name>/lyrics.txt locally. Every file that carries the lyric text is
# ignored, in every project (the aligned lyrics, the timing fixes, the low-confidence report, Whisper's words):
projects/*/audio/
projects/*/lyrics.txt
projects/*/data/lyrics*
# …except lyrics that can be shared: the P(doom) example (anime-pdoom; roto-demo reads its data) and the
# placeholder lines written for lumen-demo.
!projects/anime-pdoom/data/lyrics.js
!projects/anime-pdoom/data/lyrics.json
!projects/lumen-demo/data/lyrics.js
